# ─── Google OAuth ───────────────────────────────────────────────────────────────
# Bước 1: Vào https://console.cloud.google.com
# Bước 2: Tạo project → APIs & Services → Credentials → Create OAuth 2.0 Client ID
# Bước 3: Application type: Web application
# Bước 4: Authorized redirect URIs: http://localhost:3000/auth/google/callback
# Bước 5: Copy Client ID và Client Secret vào đây
GOOGLE_CLIENT_ID=848095153459-tgl40iq250rk0sg5o0isabb97eu8eni2.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# ─── Facebook OAuth ────────────────────────────────────────────────────────────
# Bước 1: Vào https://developers.facebook.com → My Apps → Create App
# Bước 2: Chọn "Consumer" → Add Product: Facebook Login
# Bước 3: Settings → Valid OAuth Redirect URIs: http://localhost:3000/auth/facebook/callback
# Bước 4: App Settings → Basic → lấy App ID và App Secret
FACEBOOK_APP_ID=978087024704379
FACEBOOK_APP_SECRET=a5a056aaff52b4947b473e131f32fed5

# ─── Zalo OAuth ────────────────────────────────────────────────────────────────
# Bước 1: Vào https://developers.zalo.me → My Apps → Create App
# Bước 2: Trong Login → Redirect URI: http://localhost:3000/auth/zalo/callback
# Bước 3: Copy App ID và Secret Key vào đây
